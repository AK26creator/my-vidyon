# AWS Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# AWS Region
VITE_AWS_REGION=us-east-1

# AWS Cognito Configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# API Gateway Configuration
VITE_API_ENDPOINT=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev
VITE_API_NAME=MyVidyonERP

# S3 Configuration
VITE_S3_BUCKET_NAME=my-vidyon-erp-files-dev
VITE_S3_REGION=us-east-1

# Environment
VITE_ENVIRONMENT=development

# Optional: For local development with AWS SAM/LocalStack
# VITE_USE_LOCAL_AWS=false
# VITE_LOCAL_API_ENDPOINT=http://localhost:3001
